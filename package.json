{
  "name": "@tsci/tscircuit.rk3326",
  "version": "1.0.0",
  "description": "Rockchip RK3326 TFBGA418L component and footprint for tscircuit",
  "main": "index.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "test": "bun test && bun run typecheck && tsci build --all-images --ignore-warnings && bun run validate:footprint",
    "typecheck": "tsc --noEmit",
    "validate:footprint": "bun scripts/validate-rk3326.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "tscircuit": "0.0.2185",
    "typescript": "^5.0.0"
  }
}
